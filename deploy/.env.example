# Copy to deploy/.env and replace every placeholder before starting.
# The image is built by .github/workflows/ci.yml and pushed to GHCR.
LLM_RANK_IMAGE=ghcr.io/evan-1777/llm-rankings:latest

# Generate: htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
# If htpasswd emits a $2y$ prefix, replace it with $2a$; the hash is compatible.
# Keep the single quotes so Compose does not expand the $ characters.
ADMIN_PASSWORD_HASH=''

# Generate: openssl rand -base64 48
SESSION_SECRET=''

# HTTPS-only cookie; keep true behind the TLS reverse proxy.
COOKIE_SECURE=true
# Keep false unless the reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
